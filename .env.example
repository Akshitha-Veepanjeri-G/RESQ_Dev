# RESQ Dev — Environment Configuration Template
# Copy this file to .env in the project root:
#   cp .env.example .env
# Note: .env is ignored by Git and must NEVER contain real production secrets in version control.

# --- LLM Provider Selection ---
# Supported options: "gemini" or "mock"
RESQ_LLM_PROVIDER=gemini
# Aliases supported: LLM_PROVIDER=gemini

# --- Gemini API Configuration ---
# Your Google Gemini API Key (keep this private, do not commit!)
GEMINI_API_KEY=your_gemini_api_key_here
# Aliases supported: RESQ_GEMINI_API_KEY, GOOGLE_API_KEY

# Gemini Model Name (default: gemini-2.5-flash)
RESQ_GEMINI_MODEL=gemini-2.5-flash
# Aliases supported: GEMINI_MODEL


# --- Agent Loop Limits ---
# Maximum observe-reason-act cycles per job (default: 8)
RESQ_AGENT_MAX_CYCLES=8
# Aliases supported: AGENT_MAX_CYCLES

# Maximum total tool calls per job (default: 12)
RESQ_AGENT_MAX_TOOL_CALLS=12
# Aliases supported: AGENT_MAX_TOOL_CALLS

# --- Execution Sandbox Configuration ---
DOCKER_IMAGE_NAME=resq-sandbox:latest
MAX_EXECUTION_TIMEOUT_SECONDS=10
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=64

# --- Persistence ---
DATABASE_URL=sqlite:///./resq.db
